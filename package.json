{
  "name": "dsh-llm-probe",
  "version": "1.1.0",
  "type": "module",
  "description": "开箱即用的大模型接口可用性巡检：内置巡检引擎，侧边栏「巡检看板」+ 原生工具条 + 状态角标，并给 agent 提供 llm_probe_* 工具。",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "engine/server.mjs",
    "engine/probe.mjs",
    "engine/dashboard.html",
    "engine/mailer.mjs",
    "engine/alert.mjs",
    "engine/catalog.template.json",
    "engine/keys.template.json",
    "engine/package.json",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "llm",
    "probe",
    "availability"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
